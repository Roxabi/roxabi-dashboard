---
interface Props {
  agent: "claude" | "grok" | "codex";
}
const { agent } = Astro.props;

const icons: Record<Props["agent"], string> = {
  claude: "/icons/agents/claude.svg",
  grok: "/icons/agents/grok.svg",
  codex: "/icons/agents/codex.svg",
};
---

<img
  class={`agent-tab-icon agent-tab-icon--${agent}`}
  src={icons[agent]}
  alt=""
  width="18"
  height="18"
  loading="lazy"
  decoding="async"
/>